# Keep paid stages disabled until historical reservations and provider billing are reconciled.
LIVE_ENABLED=false
# Lifetime admitted paid stages, including failed/cancelled tasks. Free examples do not consume these caps.
LESSON_TASK_LIMIT=0
NARRATION_TASK_LIMIT=0
LESSON_DAILY_LIMIT=20
NARRATION_DAILY_LIMIT=20
# CNY cents: cumulative reservations across all historical tasks, days and restarts.
# A reservation is not the provider bill. Never reset or refund it automatically.
PROJECT_BUDGET_CENTS=2000
LESSON_BUDGET_CENTS=100
NARRATION_BUDGET_CENTS=200
# Legacy shared cap retained for older tooling; runtime staged quotas use the two caps above.
LIVE_TASK_LIMIT=0
# Optional operations token (at least 32 random characters); never put it in the client.
ADMIN_TOKEN=
AI_PROVIDER=kie
# Set AI_PROVIDER=minimax to use the exact MiniMax-M3.1-Flash model for solving/review.
# MiniMax solving and speech use separate key variables; speech can use its own account.
MINIMAX_API_KEY=
MINIMAX_REGION=cn
MINIMAX_REASONING_EFFORT=medium
# Empty follows AI_PROVIDER: minimax -> MiniMax speech; kie -> KIE speech.
TTS_PROVIDER=
MINIMAX_TTS_API_KEY=
MINIMAX_TTS_REGION=cn
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE=female-chengshu
KIE_API_KEY=
KIE_CHAT_MODEL=gemini-3-pro
KIE_TTS_MODEL=elevenlabs/text-to-speech-multilingual-v2
KIE_TTS_VOICE=EkK5I93UQWFDigLMpZcX
# Legacy alternative: AI_PROVIDER=openai-compatible, with AI_BASE_URL, AI_API_KEY,
# AI_MODEL, GLM_API_KEY and optional GLM_VOICE. Not required for KIE.
# Optional legacy daily ceiling (0 leaves it unused in staged mode), and old per-job reserve.
DAY_BUDGET_CENTS=0
JOB_BUDGET_CENTS=0
HOST=127.0.0.1
PORT=8788
