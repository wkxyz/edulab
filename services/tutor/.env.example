# Keep LIVE_ENABLED=false until provider prices, per-job reserve, and budget are reviewed.
LIVE_ENABLED=false
# Lifetime admitted live tasks, including failed/cancelled tasks. Samples do not consume this cap.
# Start with 1 for the first real acceptance test; 0 blocks new live tasks.
LIVE_TASK_LIMIT=0
# Optional operations token (at least 32 random characters); never put it in the client.
ADMIN_TOKEN=
AI_PROVIDER=kie
KIE_API_KEY=
KIE_CHAT_MODEL=gemini-3-pro
KIE_TTS_MODEL=elevenlabs/text-to-speech-multilingual-v2
KIE_TTS_VOICE=EkK5I93UQWFDigLMpZcX
# Legacy alternative: AI_PROVIDER=openai-compatible, with AI_BASE_URL, AI_API_KEY,
# AI_MODEL, GLM_API_KEY and optional GLM_VOICE. Not required for KIE.
# CNY cents, conservative reservation per accepted job, not a provider-side hard spending cap.
DAY_BUDGET_CENTS=0
JOB_BUDGET_CENTS=0
HOST=127.0.0.1
PORT=8788
